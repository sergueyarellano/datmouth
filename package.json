{
  "name": "datmouth",
  "version": "2.1.0",
  "description": "p2p chat on the Holepunch stack (successor of the DAT protocol)",
  "type": "module",
  "main": "client.js",
  "bin": {
    "datmouth": "cli.js"
  },
  "files": [
    "*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "node --test \"test/*.test.js\"",
    "watch:test": "node --test --watch \"test/*.test.js\""
  },
  "keywords": [
    "chat",
    "p2p",
    "dat",
    "holepunch",
    "terminal",
    "hypercore",
    "corestore",
    "hyperswarm",
    "swarm",
    "ascii"
  ],
  "license": "ISC",
  "dependencies": {
    "b4a": "^1.9.0",
    "chalk": "^6.0.1",
    "compact-encoding": "^3.7.1",
    "corestore": "^7.16.1",
    "hyperswarm": "^4.17.2",
    "minimist": "^1.2.8",
    "protomux": "^3.13.1"
  },
  "devDependencies": {
    "hyperdht": "^6.37.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergueyarellano/datmouth.git"
  },
  "bugs": {
    "url": "https://github.com/sergueyarellano/datmouth/issues"
  },
  "homepage": "https://github.com/sergueyarellano/datmouth#readme",
  "overrides": {
    "bogon": "^1.3.0"
  }
}
